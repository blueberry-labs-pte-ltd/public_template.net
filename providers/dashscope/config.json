{
  "id": "dashscope",
  "label": "Alibaba DashScope (Qwen-Image / Wan / Z-Image)",
  "apiKeyEnv": "DASHSCOPE_API_KEY",
  "endpoint": "https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis",
  "endpointEnv": "DASHSCOPE_IMAGE_ENDPOINT",
  "headers": {
    "Authorization": "Bearer {{apiKey}}",
    "Content-Type": "application/json",
    "X-DashScope-Async": "enable"
  },
  "body": {
    "model": "{{model}}",
    "input": {
      "prompt": "{{prompt}}",
      "negative_prompt": "{{negativePrompt}}"
    },
    "parameters": {
      "size": "{{sizeStar}}",
      "n": 1
    }
  },
  "poll": {
    "endpoint": "https://dashscope-intl.aliyuncs.com/api/v1/tasks/{{taskId}}",
    "taskIdPaths": [
      "output.task_id"
    ],
    "statusPaths": [
      "output.task_status"
    ],
    "successValues": [
      "SUCCEEDED"
    ],
    "failureValues": [
      "FAILED",
      "CANCELED",
      "UNKNOWN"
    ],
    "imagePaths": [
      "output.results[].url"
    ],
    "intervalMs": 5000
  },
  "errorPaths": [
    "message",
    "output.message"
  ],
  "verified": false,
  "docs": "https://www.alibabacloud.com/help/en/model-studio/text-to-image",
  "note": "Async image-synthesis wire format. Verify the model ids (qwen-image3.0, qwen-image3.0-pro, qwen-image2.0-pro, wan2.7-t2i, wan2.7-t2i-pro, z-image-turbo) against your Model Studio console — they differ between the intl and cn hosts."
}
