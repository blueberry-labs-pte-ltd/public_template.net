# Copy to .env and fill in whichever keys you have. Anything without a key is skipped,
# reported as "SKIP (no key)", and can be filled in later without re-running the rest.

# ---------------------------------------------------------------------------
# Runware — one key covers every model Runware serves (src/resolve.mjs decides which)
# ---------------------------------------------------------------------------
RUNWARE_API_KEY=eJCP2vahxOhXZ4W91Jl6xFpsS91Qi8Fa

# ---------------------------------------------------------------------------
# Direct providers — for the models Runware does not serve.
# Output for these lands in output/non-runware/<provider>/
# ---------------------------------------------------------------------------

# GPT Image 2 (high)
OPENAI_API_KEY=

# Nano Banana 2 / Nano Banana 2 Lite
GEMINI_API_KEY=

# Qwen-Image 2.0/3.0, Wan 2.7 Image, Z-Image Turbo
DASHSCOPE_API_KEY=
# DASHSCOPE_IMAGE_ENDPOINT=          # set for the cn host instead of dashscope-intl

# Seedream 4.0 / 4.5 / 5.0 Lite / 5.0 Pro
ARK_API_KEY=
# ARK_IMAGE_ENDPOINT=

# MiniMax Image-01
MINIMAX_API_KEY=

# FLUX.2 [pro]
BFL_API_KEY=

# Ideogram 4.0
IDEOGRAM_API_KEY=

# GLM-Image
ZHIPU_API_KEY=

# ERNIE Image / Turbo
QIANFAN_API_KEY=

# Step Image Edit 2
STEPFUN_API_KEY=

# Kolors 2.1, Kling Image 3.0 Omni — both halves required (JWT is minted per request)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# MAI-Image-2.5-Flash — your own Foundry deployment, so the endpoint is required too
AZURE_IMAGE_API_KEY=
AZURE_IMAGE_ENDPOINT=

# HunyuanImage 3.0 Instruct — needs an OpenAI-compatible host (native API requires TC3 signing)
HUNYUAN_API_KEY=
HUNYUAN_IMAGE_ENDPOINT=

# HiDream-O1-Image / -Dev — set the host that serves it for you
HIDREAM_API_KEY=
HIDREAM_IMAGE_ENDPOINT=
